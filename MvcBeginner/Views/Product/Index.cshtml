@using MvcBeginner.Models.ViewModels
@model List<ProductViewModels>

	<h1>Danh Sách Sản Phẩm</h1>
<a href="/Product/Create">Them</a>
	@foreach(var product in Model)
{
	<p>
		Id: @product.Id |
	Ten: @product.Name |
	Gia: @product.Price |
	kho du tru: @product.Stock|
	hang muc: @product.CategoryName|
	nguoi cung cap: @product.SupplierName
	</p>
	<a href="/Product/Edit/@product.Id">Sua</a>
	<a href="/Product/Delete/@product.Id">Xoa</a>
}

